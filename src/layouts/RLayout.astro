---
// 方案 R · 整站即插画：共享布局（内页顶部一条画带 + 白底内容区）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import scene from '../assets/scene-placeholder.jpg';
import { withBase } from '../utils/url';
import '../styles/r.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'works' | 'about' | 'news' | 'contact';
  bandTitle?: string;
  bandEn?: string;
}

const {
  title = 'HEHXumike · 画作集',
  description = 'HEHXumike 的个人画作集——数字插画与板绘。',
  active,
  bandTitle,
  bandEn,
} = Astro.props;

const nav = [
  { key: 'works', href: withBase('/r/works'), cn: '作品', en: 'Works' },
  { key: 'about', href: withBase('/r/about'), cn: '关于', en: 'About' },
  { key: 'news', href: withBase('/r/news'), cn: '动态', en: 'News' },
  { key: 'contact', href: withBase('/r/contact'), cn: '联系', en: 'Contact' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    {
      bandTitle && (
        <header class="r-band">
          <Image
            class="r-band-img"
            src={scene}
            alt="场景插画（占位图，待替换为画家本人的场景原作）"
            widths={[1600, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <div class="r-veil" aria-hidden="true" />
          <div class="r-topbar">
            <a class="r-brand" href={withBase('/r')}>HEHXumike</a>
            <nav class="r-nav" aria-label="主导航">
              {nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={active === item.key ? 'page' : undefined}
                >
                  <span>{item.cn}</span>
                  <span class="en">{item.en}</span>
                </a>
              ))}
            </nav>
          </div>
          <div class="r-band-title">
            {bandEn && <p class="r-en">{bandEn}</p>}
            <h1>{bandTitle}</h1>
          </div>
        </header>
      )
    }

    <main class="r-main">
      <slot />
    </main>

    <footer class="r-foot">
      <span>© {new Date().getFullYear()} HEHXumike · 画作版权归画家本人所有</span>
      <span class="r-en">Paintings &amp; Illustrations</span>
    </footer>
    <a class="r-switch" href={withBase('/styles')}>方案 R · 换个方案 →</a>
  </body>
</html>