---
import WorkGallery from "@/components/layout/WorkGallery.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

const posts = await getSortedPosts();
const seriesOrder = ["角色插画", "风景", "幻想"];
const seriesList = [
	...new Set(posts.map((post) => post.data.series).filter(Boolean)),
].sort((a, b) => seriesOrder.indexOf(a) - seriesOrder.indexOf(b));
const seriesCounts = Object.fromEntries(
	seriesList.map((series) => [
		series,
		posts.filter((post) => post.data.series === series).length,
	]),
);
const title = "作品";
const description = `共 ${posts.length} 件 · 精选作品`;
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell works-index-shell">
		<div class="card-base p-4 md:p-6">
			<div class="mb-3 flex flex-wrap items-end justify-between gap-2">
				<div>
					<p class="text-xs font-medium uppercase tracking-[0.22em] text-(--primary) lg:hidden">
						Works
					</p>
					<h2 class="mt-1 text-2xl font-bold text-90 lg:hidden">作品</h2>
					<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">{description}</p>
				</div>
				<a href="/series/" class="text-sm text-(--primary) transition hover:underline">按系列浏览 →</a>
			</div>
			<works-filter class="mb-4 flex flex-wrap items-center gap-2">
				<button
					type="button"
					class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
					data-filter="all"
					data-active
					aria-pressed="true"
				>
					全部 <span class="pill-count">{posts.length}</span>
				</button>
				{seriesList.map((series) => (
					<button
						type="button"
						class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
						data-filter={series}
						aria-pressed="false"
					>
						{series} <span class="pill-count">{seriesCounts[series]}</span>
					</button>
				))}
			</works-filter>

			<WorkGallery posts={posts} />
		</div>
	</section>

	<script slot="head" is:inline>
		if (!customElements.get("works-filter")) {
			class WorksFilter extends HTMLElement {
				connectedCallback() {
					this.addEventListener("click", (event) => {
						const button = event.target.closest("button[data-filter]");
						if (!button) return;
						this.querySelectorAll("button[data-filter]").forEach((item) => {
							item.removeAttribute("data-active");
							item.setAttribute("aria-pressed", "false");
						});
						button.setAttribute("data-active", "");
						button.setAttribute("aria-pressed", "true");
						const filter = button.dataset.filter;
						const grid = this.closest(".works-index-shell")?.querySelector(".works-masonry");
						if (!grid) return;
						grid.querySelectorAll(".works-cell").forEach((cell) => {
							cell.hidden =
								filter !== "all" && cell.dataset.series !== filter;
						});
					});
				}
			}
			customElements.define("works-filter", WorksFilter);
		}
	</script>

	<style is:global>
		/* /works 是纯画廊页：让作品占满内容宽度，不保留左右侧栏 */
		#main-grid:has(.works-index-shell) {
			grid-template-columns: minmax(0, 1fr) !important;
		}
		#main-grid:has(.works-index-shell) > :not(#content-column) {
			display: none !important;
		}
		#main-grid:has(.works-index-shell) #mobile-bottom-sidebar {
			display: none !important;
		}
	</style>
</MainGridLayout>