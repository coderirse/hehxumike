---
// 方案 C · 电影翻阅画册：满屏首图大字开卷，向下单页画册式左右交错翻阅（预览用临时页）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = works.find((w) => w.data.featured) ?? works[0];
const picked = works.filter((w) => w !== featured).slice(0, 6);
const metaOf = (w: (typeof works)[number]) =>
  [w.data.year, w.data.medium, w.data.size].filter(Boolean).join(' · ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>方案 C · 电影翻阅画册 — HEHXumike</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">HEHXumike</a>
      <nav aria-label="预览导航（装饰）">
        <span>作品</span><span>关于</span><span>动态</span><span>联系</span>
      </nav>
    </header>

    <!-- 满屏电影感首图：整张画铺满视口，大字压在上面 -->
    <section class="hero">
      <Image
        class="bg"
        src={featured.data.image}
        alt=""
        widths={[1200, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="shade" aria-hidden="true"></div>
      <div class="copy">
        <p class="kicker">HEHXumike · Portfolio 2026</p>
        <h1>把每一张画，<br />挂在它应得的墙上。</h1>
        <p class="meta">数字插画 · 板绘 —— 角色立绘 / 节日贺图 / 封面与自设</p>
      </div>
      <div class="cue" aria-hidden="true"><span></span>往下翻</div>
    </section>

    <!-- 单页画册：一页一画，左右交错，像翻看精装画册 -->
    <main class="book pswp-gallery">
      <header class="sec">
        <h2>作品</h2>
        <span class="sec-en">Selected · 01—06</span>
      </header>
      {
        picked.map((w, i) => (
          <figure class:list={['leaf', { flip: i % 2 === 1 }]}>
            <a
              class="ph"
              href={w.data.image.src}
              data-pswp
              data-width={w.data.image.width}
              data-height={w.data.image.height}
              data-title={w.data.title}
              data-title-en={w.data.titleEn ?? ''}
              data-meta={metaOf(w)}
            >
              <Image
                src={w.data.image}
                alt={w.data.title}
                widths={[720, 1200]}
                sizes="(max-width: 800px) 90vw, 560px"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </a>
            <figcaption>
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">
                <h3>《{w.data.title}》</h3>
                <p>{metaOf(w)}</p>
              </span>
            </figcaption>
          </figure>
        ))
      }
      <a class="more" href="/works">全部 {works.length} 件作品 →</a>
    </main>

    <footer class="foot">© 2026 HEHXumike · 画作版权归画家本人所有</footer>
    <a class="switch" href="/styles">方案 C / 5 · 换个方案 →</a>
    <Lightbox />
  </body>
</html>

<style is:global>
  :root {
    --paper: #fcfcfa;
    --ink: #141311;
    --dim: #8c887e;
    --accent: #b23b2e;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Noto Serif SC', serif;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
  }

  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.1rem clamp(1rem, 3vw, 2.4rem);
    mix-blend-mode: difference;
    color: #fff;
  }
  .brand {
    font-family: 'EB Garamond', serif;
    letter-spacing: 0.08em;
    font-size: 1.02rem;
  }
  .bar nav {
    display: flex;
    gap: 1.7rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    opacity: 0.85;
  }

  /* 满屏首图 */
  .hero {
    position: relative;
    height: 100svh;
    overflow: hidden;
  }
  .hero .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero .bg {
      animation: settle 16s ease-out both;
    }
    @keyframes settle {
      from {
        transform: scale(1.07);
      }
      to {
        transform: scale(1);
      }
    }
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.16), rgb(0 0 0 / 0.58));
  }
  .copy {
    position: absolute;
    left: clamp(1.25rem, 7vw, 6rem);
    bottom: clamp(4rem, 12vh, 7rem);
    color: #fff;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .kicker {
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .copy h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 6.5vw, 5.6rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: 0.05em;
  }
  .meta {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    opacity: 0.85;
  }
  .cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
  }
  .cue span {
    width: 1px;
    height: 42px;
    background: rgb(255 255 255 / 0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cue span {
      animation: drip 2.2s ease-in-out infinite;
      transform-origin: top;
    }
    @keyframes drip {
      0% {
        transform: scaleY(0.2);
      }
      55% {
        transform: scaleY(1);
      }
      100% {
        transform: scaleY(0.2);
      }
    }
  }

  /* 画册翻阅区 */
  .book {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }
  .sec {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1rem;
  }
  .sec h2 {
    font-size: 2rem;
    letter-spacing: 0.14em;
  }
  .sec-en {
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .leaf {
    width: min(62%, 560px);
    margin: clamp(4.5rem, 9vw, 7.5rem) 0 0;
  }
  .leaf.flip {
    margin-left: auto;
  }
  .leaf .ph img {
    width: 100%;
    height: auto;
  }
  .leaf figcaption {
    margin-top: 1.3rem;
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
  }
  .leaf.flip figcaption {
    flex-direction: row-reverse;
    text-align: right;
  }
  .no {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1;
    color: #cdc9bd;
  }
  .t h3 {
    font-size: 1.35rem;
    letter-spacing: 0.08em;
  }
  .t p {
    margin-top: 0.3rem;
    color: var(--dim);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .more {
    display: block;
    width: fit-content;
    margin: clamp(4rem, 8vw, 6rem) auto 0;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    letter-spacing: 0.12em;
  }
  .more:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .foot {
    border-top: 1px solid #e3e0d8;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 2rem clamp(1.25rem, 4vw, 3rem);
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
    background: rgb(252 252 250 / 0.85);
    border: 1px solid #d9d6cd;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
  }
  .switch:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .bar nav {
      display: none;
    }
    .leaf {
      width: 88%;
    }
  }
</style>
