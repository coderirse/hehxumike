---
// 方案 R · 整站即插画（rossdraws 式复刻，原创实现）：
// 首屏一整幅画 = 界面本身，导航词嵌在画里；往下滚接 yuumei 式作品方格墙（预览用临时页）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';
import scene from '../assets/scene-placeholder.jpg';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 首屏「画中导航」热区：坐标 = 画布百分比（left/top）。
// 真实场景插画到位后，按画面构图微调这四个坐标即可（见 AGENTS.md §10）。
const hotspots = [
  { label: '作品', en: 'gallery', href: '#gallery', x: 63, y: 32 },
  { label: '关于', en: 'about', href: '/about', x: 76, y: 50 },
  { label: '动态', en: 'news', href: '/news', x: 44, y: 64 },
  { label: '联系', en: 'contact', href: '/contact', x: 24, y: 44 },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>方案 R · 整站即插画 — HEHXumike</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <!-- 首屏：一整幅画 = 界面本身 -->
    <section class="stage">
      <Image
        class="scene"
        src={scene}
        alt="场景插画（占位图，待替换为画家本人的场景原作）"
        widths={[1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="veil" aria-hidden="true"></div>

      <a class="brand" href="/">HEHXumike</a>

      {
        hotspots.map((h) => (
          <a class="spot" href={h.href} style={`left:${h.x}%; top:${h.y}%`}>
            <span class="cn">{h.label}</span>
            <span class="en">{h.en}</span>
          </a>
        ))
      }

      <div class="cue" aria-hidden="true"><span></span>往下走进画廊</div>
    </section>

    <!-- 作品方格墙（yuumei 式）：作品直接铺满，点开即灯箱 -->
    <main id="gallery" class="wall pswp-gallery">
      <header class="sec">
        <h2>作品</h2>
        <span class="sec-en">Gallery · {works.length} 件</span>
      </header>
      <div class="grid">
        {
          works.map((w, i) => (
            <a
              class="cell"
              href={w.data.image.src}
              data-pswp
              data-width={w.data.image.width}
              data-height={w.data.image.height}
              data-title={w.data.title}
              data-title-en={w.data.titleEn ?? ''}
              data-meta={[w.data.year, w.data.medium].filter(Boolean).join(' · ')}
            >
              <Image
                src={w.data.image}
                alt={w.data.title}
                widths={[480, 840]}
                sizes="(max-width: 700px) 50vw, (max-width: 1100px) 33vw, 25vw"
                loading={i < 8 ? 'eager' : 'lazy'}
              />
              <span class="cap" aria-hidden="true">《{w.data.title}》</span>
            </a>
          ))
        }
      </div>
    </main>

    <footer class="foot">© 2026 HEHXumike · 画作版权归画家本人所有</footer>
    <a class="switch" href="/styles">方案 R · 换个方案 →</a>
    <Lightbox />
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1a1a;
    --dim: #8c887e;
    --paper: #fafaf8;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Noto Serif SC', serif;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
  }

  /* ---- 首屏画布 ---- */
  .stage {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #171a17;
  }
  .stage .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stage .scene {
      animation: settle 18s ease-out both;
    }
    @keyframes settle {
      from {
        transform: scale(1.05);
      }
      to {
        transform: scale(1);
      }
    }
  }
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.28), transparent 30%, transparent 72%, rgb(0 0 0 / 0.3));
  }

  .brand {
    position: absolute;
    top: 1.4rem;
    left: 1.8rem;
    z-index: 3;
    font-family: 'EB Garamond', serif;
    letter-spacing: 0.14em;
    font-size: 1.05rem;
    color: #fff;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.5);
  }

  /* 画中导航词 */
  .spot {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    color: #fff;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.55);
    transition: filter 0.35s ease;
  }
  .spot .cn {
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    position: relative;
  }
  .spot .cn::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -0.35rem;
    height: 1px;
    background: #fff;
    transform: scaleX(0);
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.21, 1);
  }
  .spot .en {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    opacity: 0.85;
  }
  .spot:hover {
    filter: drop-shadow(0 0 14px rgb(255 255 255 / 0.45));
  }
  .spot:hover .cn::after {
    transform: scaleX(1);
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 1.3rem;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: rgb(255 255 255 / 0.88);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
  }
  .cue span {
    width: 1px;
    height: 40px;
    background: rgb(255 255 255 / 0.75);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cue span {
      animation: drip 2.2s ease-in-out infinite;
      transform-origin: top;
    }
    @keyframes drip {
      0% {
        transform: scaleY(0.2);
      }
      55% {
        transform: scaleY(1);
      }
      100% {
        transform: scaleY(0.2);
      }
    }
  }

  /* ---- 作品方格墙 ---- */
  .wall {
    max-width: 100rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(0.75rem, 1.5vw, 1.25rem) clamp(2rem, 4vw, 3rem);
  }
  .sec {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0 0.5rem 1.2rem;
  }
  .sec h2 {
    font-size: 1.4rem;
    letter-spacing: 0.14em;
  }
  .sec-en {
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .cell {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #e8e5de;
  }
  .cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.21, 1);
  }
  .cell:hover img {
    transform: scale(1.05);
  }
  .cell .cap {
    position: absolute;
    left: 10px;
    bottom: 8px;
    color: #fff;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.6);
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .cell:hover .cap {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .spot .en {
      display: none;
    }
    .spot .cn {
      font-size: 1.25rem;
    }
  }

  .foot {
    padding: 1.8rem clamp(1.25rem, 3vw, 2.4rem) 2.4rem;
    border-top: 1px solid #e7e4de;
    color: var(--dim);
    font-size: 0.8rem;
  }
  .switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
    background: rgb(250 250 248 / 0.9);
    border: 1px solid #d9d6cd;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
  }
  .switch:hover {
    color: var(--ink);
  }
</style>
