---
// 方案 D · 横向长廊：像走在展厅走廊，滚轮/拖动向右看画（预览用临时页）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';
import { withBase } from '../utils/url';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const metaOf = (w: (typeof works)[number]) =>
  [w.data.year, w.data.medium, w.data.size].filter(Boolean).join(' · ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>方案 D · 横向长廊 — HEHXumike</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    <header class="top">
      <span class="brand">HEHXumike</span>
      <span class="hint">滚轮 / 按住拖动 → 向右看展</span>
    </header>
    <div class="progress" aria-hidden="true"><i id="bar"></i></div>

    <!-- 横向轨道：页面只左右滚，像走在一条走廊里 -->
    <main class="rail pswp-gallery" id="rail">
      <section class="panel head">
        <p class="kicker">Gallery Corridor</p>
        <h1>横向长廊</h1>
        <p class="sub">{works.length} 件作品挂在走廊两侧，一路向右。</p>
      </section>
      {
        works.map((w, i) => (
          <figure class="panel piece">
            <a
              class="ph"
              href={withBase(w.data.image.src)}
              data-pswp
              data-width={w.data.image.width}
              data-height={w.data.image.height}
              data-title={w.data.title}
              data-title-en={w.data.titleEn ?? ''}
              data-meta={metaOf(w)}
            >
              <Image
                src={w.data.image}
                alt={w.data.title}
                widths={[800, 1400]}
                sizes="(max-height: 800px) 55vh, 56vh"
                loading={i < 3 ? 'eager' : 'lazy'}
              />
            </a>
            <figcaption>
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">《{w.data.title}》</span>
              <span class="m">{metaOf(w)}</span>
            </figcaption>
          </figure>
        ))
      }
      <section class="panel end">
        <h2>走到头了</h2>
        <p>喜欢哪一张？<a href={withBase('/works')}>回去从头看 →</a></p>
      </section>
    </main>

    <a class="switch" href={withBase('/styles')}>方案 D / 5 · 换个方案 →</a>
    <Lightbox />

    <script>
      // 滚轮转横向 + 按住拖动 + 顶部进度线
      function setup() {
        const rail = document.getElementById('rail') as HTMLElement | null;
        if (!rail) return;
        const bar = document.getElementById('bar');
        const max = () => rail.scrollWidth - rail.clientWidth;

        const onWheel = (e: WheelEvent) => {
          if (Math.abs(e.deltaY) >= Math.abs(e.deltaX)) {
            rail.scrollLeft += e.deltaY;
            e.preventDefault();
          }
        };
        rail.addEventListener('wheel', onWheel, { passive: false });

        let down: number | null = null;
        let startX = 0;
        let startLeft = 0;
        rail.addEventListener('pointerdown', (e) => {
          down = e.pointerId;
          startX = e.clientX;
          startLeft = rail.scrollLeft;
          rail.setPointerCapture(e.pointerId);
        });
        rail.addEventListener('pointermove', (e) => {
          if (down === null) return;
          rail.scrollLeft = startLeft - (e.clientX - startX);
        });
        const up = () => {
          down = null;
        };
        rail.addEventListener('pointerup', up);
        rail.addEventListener('pointercancel', up);

        const onScroll = () => {
          if (bar) bar.style.width = `${max() > 0 ? (rail.scrollLeft / max()) * 100 : 0}%`;
        };
        rail.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --wall: #efece6;
    --ink: #1d1b17;
    --dim: #8a857a;
    --line: #d8d3c8;
    --accent: #b23b2e;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--wall);
    color: var(--ink);
    font-family: 'Noto Serif SC', serif;
    height: 100vh;
    overflow: hidden; /* 只横向滚 */
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
  }

  .top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(rgb(239 236 230 / 0.92), rgb(239 236 230 / 0));
  }
  .brand {
    font-family: 'EB Garamond', serif;
    letter-spacing: 0.08em;
    font-size: 1.02rem;
  }
  .hint {
    color: var(--dim);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
  }
  .progress {
    position: fixed;
    inset: 3rem 0 auto 0;
    height: 2px;
    background: var(--line);
    z-index: 10;
  }
  .progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }

  .rail {
    height: 100vh;
    display: flex;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-inline: clamp(1.5rem, 8vw, 8rem);
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail:active {
    cursor: grabbing;
  }
  .panel {
    flex: none;
  }

  .head {
    max-width: 30rem;
  }
  .kicker {
    font-family: 'EB Garamond', serif;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .head h1 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    letter-spacing: 0.1em;
  }
  .sub {
    margin-top: 1rem;
    color: var(--dim);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
  }

  .piece .ph img {
    height: 56vh;
    width: auto;
    max-width: 74vw;
    object-fit: cover;
    background: #e2ded4;
  }
  .piece figcaption {
    margin-top: 1.1rem;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .piece .no {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 1.6rem;
    color: #c6c0b2;
  }
  .piece .t {
    font-size: 1.02rem;
    letter-spacing: 0.06em;
  }
  .piece .m {
    color: var(--dim);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .end {
    max-width: 22rem;
  }
  .end h2 {
    font-size: 1.7rem;
    letter-spacing: 0.12em;
  }
  .end p {
    margin-top: 0.8rem;
    color: var(--dim);
    font-size: 0.92rem;
  }
  .end a {
    border-bottom: 1px solid var(--ink);
  }
  .end a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    font-family: 'EB Garamond', serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
    background: rgb(239 236 230 / 0.85);
    border: 1px solid var(--line);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
  }
  .switch:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .hint {
      display: none;
    }
    .piece .ph img {
      max-width: 84vw;
    }
  }
</style>
