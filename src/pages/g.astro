---
// 方案 G · 卡牌收藏墙：每件作品是一张收藏卡，渐变卡边 + 悬停 3D 倾斜 + 流光扫过（预览用临时页）
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/700.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';
import { withBase } from '../utils/url';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const metaOf = (w: (typeof works)[number]) =>
  [w.data.year, w.data.medium, w.data.size].filter(Boolean).join(' · ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>方案 G · 卡牌收藏墙 — HEHXumike</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    <span class="blob pink" aria-hidden="true"></span>
    <span class="blob cyan" aria-hidden="true"></span>

    <!-- 收藏册封面式页头 -->
    <header class="head">
      <span class="emblem" aria-hidden="true">H</span>
      <h1>HEHXUMIKE</h1>
      <p class="sub">Collection · 2026 · 数字插画板绘</p>
      <div class="chips">
        <span class="chip">{works.length} CARDS</span>
        <span class="chip">SSR 全收录</span>
      </div>
    </header>

    <!-- 收藏卡墙：统一卡位，悬停倾斜 + 流光 -->
    <main class="shelf pswp-gallery">
      {
        works.map((w, i) => (
          <div class="cardwrap tilt">
            <div class="card">
              <a
                class="ph"
                href={withBase(w.data.image.src)}
                data-pswp
                data-width={w.data.image.width}
                data-height={w.data.image.height}
                data-title={w.data.title}
                data-title-en={w.data.titleEn ?? ''}
                data-meta={metaOf(w)}
              >
                <span class="no">#{String(i + 1).padStart(2, '0')}</span>
                <Image
                  src={w.data.image}
                  alt={w.data.title}
                  widths={[560, 900]}
                  sizes="(max-width: 800px) 88vw, 30vw"
                  loading={i < 6 ? 'eager' : 'lazy'}
                />
              </a>
              <div class="info">
                <div class="row">
                  <b>《{w.data.title}》</b>
                  <span class="yr">{w.data.year}</span>
                </div>
                <div class="row2">
                  <span class="tag">{w.data.series}</span>
                  {w.data.featured && <span class="tag hot">★ 精选</span>}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </main>

    <footer class="foot">© 2026 HEHXumike · 画作版权归画家本人所有 · 收藏卡墙</footer>
    <a class="switch" href={withBase('/styles')}>方案 G / 7 · 换个方案 →</a>
    <Lightbox />

    <script>
      // 悬停 3D 倾斜（尊重系统减弱动态设置；触屏不启用）
      function setup() {
        const cards = document.querySelectorAll<HTMLElement>('.cardwrap.tilt');
        if (!cards.length) return;
        if (!matchMedia('(pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        cards.forEach((wrap) => {
          const onMove = (e: MouseEvent) => {
            const r = wrap.getBoundingClientRect();
            const dx = (e.clientX - r.left) / r.width - 0.5;
            const dy = (e.clientY - r.top) / r.height - 0.5;
            wrap.style.transform = `perspective(900px) rotateY(${dx * 10}deg) rotateX(${-dy * 10}deg) translateY(-2px)`;
          };
          const onLeave = () => {
            wrap.style.transform = '';
          };
          wrap.addEventListener('mousemove', onMove);
          wrap.addEventListener('mouseleave', onLeave);
        });
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f2ff;
    --ink: #241f3d;
    --dim: #7d799b;
    --violet: #6b5bd6;
    --pink: #ff9ac4;
    --blue: #9db8ff;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    overflow-x: hidden;
  }
  .blob {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    pointer-events: none;
    z-index: -1;
  }
  .blob.pink {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, var(--pink), transparent 70%);
    top: -160px;
    left: -120px;
  }
  .blob.cyan {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, var(--blue), transparent 70%);
    bottom: -140px;
    right: -120px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
  }

  .head {
    text-align: center;
    padding: clamp(3.5rem, 8vh, 5.5rem) 1.5rem 2.6rem;
  }
  .emblem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--blue));
    color: #fff;
    font-weight: 700;
    font-size: 1.5rem;
    box-shadow: 0 12px 30px rgb(157 107 255 / 0.35);
  }
  .head h1 {
    margin-top: 1.2rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
  }
  .sub {
    margin-top: 0.5rem;
    color: var(--dim);
    font-size: 0.88rem;
    letter-spacing: 0.14em;
  }
  .chips {
    margin-top: 1.1rem;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }
  .chip {
    border: 1px solid rgb(107 91 214 / 0.35);
    color: var(--violet);
    background: rgb(255 255 255 / 0.7);
    padding: 0.24rem 0.95rem;
    border-radius: 999px;
    font-size: 0.74rem;
    letter-spacing: 0.12em;
  }

  .shelf {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem clamp(1.25rem, 4vw, 3rem) 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .cardwrap {
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
  }
  .card {
    position: relative;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgb(107 91 214 / 0.14);
  }
  /* 渐变卡边：外层渐变 + 内层留缝 */
  .cardwrap {
    background: linear-gradient(135deg, var(--pink), var(--blue) 55%, #c3b1ff);
    padding: 1.5px;
    border-radius: 19px;
  }
  .card .ph {
    position: relative;
    display: block;
  }
  .card .ph img {
    width: 100%;
    height: auto;
  }
  .card .no {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    color: var(--violet);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
  }
  /* 流光扫过 */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 32%, rgb(255 255 255 / 0.5) 50%, transparent 68%);
    transform: translateX(-130%);
    transition: transform 0.9s ease;
    pointer-events: none;
  }
  .cardwrap:hover .card::after {
    transform: translateX(130%);
  }
  .cardwrap:hover {
    box-shadow: 0 24px 60px rgb(107 91 214 / 0.3);
    border-radius: 19px;
  }

  .info {
    padding: 0.95rem 1.15rem 1.1rem;
  }
  .info .row {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .info b {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .info .yr {
    margin-left: auto;
    color: var(--dim);
    font-size: 0.78rem;
  }
  .info .row2 {
    margin-top: 0.55rem;
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    border: 1px solid rgb(107 91 214 / 0.3);
    color: var(--violet);
    background: #f1eeff;
    font-size: 0.7rem;
    padding: 0.14rem 0.7rem;
    border-radius: 999px;
    letter-spacing: 0.06em;
  }
  .tag.hot {
    border-color: rgb(255 154 196 / 0.5);
    color: #d6498f;
    background: #fff0f6;
  }

  .foot {
    text-align: center;
    color: var(--dim);
    font-size: 0.78rem;
    padding: 2.4rem 1.5rem 2.8rem;
  }
  .switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
    background: rgb(255 255 255 / 0.88);
    border: 1px solid rgb(107 91 214 / 0.3);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
  }
  .switch:hover {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 580px) {
    .shelf {
      grid-template-columns: 1fr;
    }
  }
</style>
