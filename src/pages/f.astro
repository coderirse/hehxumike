---
// 方案 F · 霓虹夜场：暗底荧光渐变 + 跑马灯 + 霓虹画框，为二次元板绘而生的夜场（预览用临时页）
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/700.css';
import '@fontsource/noto-sans-sc/900.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = works.find((w) => w.data.featured) ?? works[0];
const metaOf = (w: (typeof works)[number]) =>
  [w.data.year, w.data.medium].filter(Boolean).join(' · ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>方案 F · 霓虹夜场 — HEHXumike</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">HEH<span class="grad">Xumike</span></a>
      <nav aria-label="预览导航（装饰）">
        <span>作品</span><span>关于</span><span>动态</span><span>联系</span>
      </nav>
    </header>

    <!-- 首屏：荧光球体 + 大字 + 霓虹画框精选 -->
    <section class="hero">
      <span class="orb pink" aria-hidden="true"></span>
      <span class="orb cyan" aria-hidden="true"></span>

      <div class="copy">
        <div class="chips">
          <span class="chip">二次元插画</span>
          <span class="chip">板绘</span>
          <span class="chip">EST. 2026</span>
        </div>
        <h1>
          把每一张画，<br />
          挂在<span class="grad">它应得</span>的墙上。
        </h1>
        <p class="sub">数字插画 · 板绘 —— 角色立绘 / 节日贺图 / 封面与自设</p>
        <div class="cta">
          <a class="btn grad-bg" href="/works">进入画廊 →</a>
          <a class="btn ghost" href="/contact">与我联系</a>
        </div>
      </div>

      <figure class="art">
        <div class="nframe float">
          <a
            class="inner"
            href={featured.data.image.src}
            data-pswp
            data-width={featured.data.image.width}
            data-height={featured.data.image.height}
            data-title={featured.data.title}
            data-title-en={featured.data.titleEn ?? ''}
            data-meta={metaOf(featured)}
          >
            <Image
              src={featured.data.image}
              alt={featured.data.title}
              widths={[640, 1080]}
              sizes="(max-width: 900px) 88vw, 38vw"
              loading="eager"
              fetchpriority="high"
            />
          </a>
        </div>
        <figcaption><span class="chip mini">精选</span>《{featured.data.title}》 {featured.data.year}</figcaption>
      </figure>

      <span class="side" aria-hidden="true">二次元创作中 · 二〇二六</span>
    </section>

    <!-- 跑马灯横幅 -->
    <div class="marquee" aria-hidden="true">
      <div class="track">
        <span>ILLUSTRATION ✦ 数字插画 ✦ 板绘 ✦ 角色立绘 ✦ 节日贺图 ✦ 封面与自设 ✦ HEHXUMIKE ✦ </span>
        <span>ILLUSTRATION ✦ 数字插画 ✦ 板绘 ✦ 角色立绘 ✦ 节日贺图 ✦ 封面与自设 ✦ HEHXUMIKE ✦ </span>
      </div>
    </div>

    <!-- 作品：霓虹画框卡阵 -->
    <main class="works pswp-gallery">
      <header class="sec">
        <h2>作品</h2>
        <span class="count chip mini">{works.length} 件</span>
        <span class="sec-en">Works</span>
      </header>
      <div class="grid">
        {
          works.map((w, i) => (
            <div class="nframe hover" data-reveal>
              <div class="cardin">
                <a
                  href={w.data.image.src}
                  data-pswp
                  data-width={w.data.image.width}
                  data-height={w.data.image.height}
                  data-title={w.data.title}
                  data-title-en={w.data.titleEn ?? ''}
                  data-meta={metaOf(w)}
                >
                  <Image
                    src={w.data.image}
                    alt={w.data.title}
                    widths={[560, 960]}
                    sizes="(max-width: 800px) 88vw, 30vw"
                    loading={i < 6 ? 'eager' : 'lazy'}
                  />
                </a>
                <div class="bar">
                  <b>《{w.data.title}》</b>
                  <span class="chip mini">{w.data.series}</span>
                  <span class="yr">{w.data.year}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </main>

    <footer class="foot">© 2026 HEHXumike · 画作版权归画家本人所有</footer>
    <a class="switch" href="/styles">方案 F / 7 · 换个方案 →</a>
    <Lightbox />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d17;
    --panel: #12152a;
    --ink: #eef0ff;
    --dim: #8b90b8;
    --neon1: #ff4d8f;
    --neon2: #4dd8ff;
    --neon3: #9d6bff;
    --line: rgb(140 150 220 / 0.18);
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    overflow-x: hidden;
  }
  /* 细网格底纹 */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
  }
  .grad {
    background: linear-gradient(92deg, var(--neon1), var(--neon2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .grad-bg {
    background: linear-gradient(92deg, var(--neon1), var(--neon3));
    color: #fff;
  }

  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem clamp(1.25rem, 4vw, 2.6rem);
    background: rgb(11 13 23 / 0.72);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .bar nav {
    display: flex;
    gap: 1.8rem;
    font-size: 0.86rem;
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  .hero {
    position: relative;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(6.5rem, 12vh, 9rem) clamp(1.25rem, 4vw, 3rem) 4rem;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.45;
    pointer-events: none;
    z-index: -1;
  }
  .orb.pink {
    width: 440px;
    height: 440px;
    background: radial-gradient(circle, var(--neon1), transparent 70%);
    top: -60px;
    right: -80px;
  }
  .orb.cyan {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, var(--neon2), transparent 70%);
    bottom: -120px;
    left: -100px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb.pink {
      animation: bob 9s ease-in-out infinite alternate;
    }
    .orb.cyan {
      animation: bob 11s ease-in-out infinite alternate-reverse;
    }
    @keyframes bob {
      to {
        transform: translateY(26px);
      }
    }
  }

  .chips {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .chip {
    border: 1px solid rgb(157 107 255 / 0.45);
    color: #c9cdf8;
    padding: 0.28rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }
  .chip.mini {
    font-size: 0.68rem;
    padding: 0.14rem 0.7rem;
  }
  .hero h1 {
    margin-top: 1.6rem;
    font-size: clamp(2.5rem, 5.5vw, 4.4rem);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .sub {
    margin-top: 1.2rem;
    color: var(--dim);
    font-size: 0.92rem;
    letter-spacing: 0.08em;
  }
  .cta {
    margin-top: 2.2rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .btn {
    padding: 0.72rem 1.7rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition:
      transform 0.3s ease,
      filter 0.3s ease,
      border-color 0.3s;
  }
  .btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.15);
  }
  .btn.ghost {
    border: 1px solid var(--line);
    color: var(--dim);
    background: transparent;
  }
  .btn.ghost:hover {
    color: var(--ink);
    border-color: rgb(157 107 255 / 0.5);
    filter: none;
  }

  .art figcaption {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--dim);
    font-size: 0.85rem;
  }
  .nframe {
    background: linear-gradient(135deg, var(--neon1), var(--neon2) 55%, var(--neon3));
    padding: 2px;
    border-radius: 20px;
  }
  .nframe .inner,
  .nframe .cardin {
    display: block;
    background: var(--panel);
    border-radius: 18px;
    overflow: hidden;
  }
  .nframe .inner img,
  .nframe .cardin img {
    width: 100%;
    height: auto;
  }
  .float {
    box-shadow: 0 24px 80px rgb(157 107 255 / 0.3);
  }
  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: hover-float 6s ease-in-out infinite alternate;
    }
    @keyframes hover-float {
      to {
        transform: translateY(-14px);
      }
    }
  }

  .side {
    position: absolute;
    right: clamp(0.25rem, 1vw, 0.8rem);
    top: clamp(5rem, 10vh, 8rem);
    writing-mode: vertical-rl;
    font-size: 0.75rem;
    letter-spacing: 0.42em;
    color: var(--dim);
  }

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 0.85rem 0;
    background: rgb(18 21 42 / 0.6);
  }
  .track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    color: var(--dim);
    font-size: 0.82rem;
    letter-spacing: 0.24em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: roll 26s linear infinite;
    }
    @keyframes roll {
      to {
        transform: translateX(-50%);
      }
    }
  }

  .works {
    max-width: 76rem;
    margin: 0 auto;
    padding: 4rem clamp(1.25rem, 4vw, 3rem) 3.5rem;
  }
  .sec {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.4rem;
  }
  .sec h2 {
    font-size: 1.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
  .sec-en {
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    color: var(--dim);
    text-transform: uppercase;
    margin-left: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
  }
  .nframe.hover {
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  .nframe.hover:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgb(255 77 143 / 0.22), 0 20px 60px rgb(77 216 255 / 0.14);
  }
  .cardin .bar {
    position: static;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--line);
    background: rgb(11 13 23 / 0.55);
  }
  .cardin .bar b {
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }
  .cardin .yr {
    margin-left: auto;
    color: var(--dim);
    font-size: 0.8rem;
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .side {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bar nav {
      display: none;
    }
  }

  .foot {
    max-width: 76rem;
    margin: 0 auto;
    padding: 1.6rem clamp(1.25rem, 4vw, 3rem) 2.2rem;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 0.78rem;
  }
  .switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--dim);
    background: rgb(11 13 23 / 0.85);
    border: 1px solid var(--line);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
  }
  .switch:hover {
    color: var(--ink);
  }
</style>
