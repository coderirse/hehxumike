---
// 临时页：界面方案挑选（A–G + R 八套界面，定稿后删除本页与临时方案页）
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const groups = [
  {
    name: '同频系 · 和二次元作品一个气质',
    hint: '作品自己的语言：霓虹、卡牌、手帐 —— 注意占位图是随机照片，换成你的原作后这套会更明显',
    items: [
      {
        href: withBase('/r'),
        key: 'R',
        cn: '整站即插画',
        en: 'Living Painting',
        bg: '#232a24',
        border: false,
        tag: '候选 · 全站',
        desc: 'rossdraws 式（原创复刻）：首屏一整幅画当界面，导航嵌在画里；已扩成五页完整站（作品/关于/动态/联系）。需要你一张场景原作。',
      },
      {
        href: withBase('/f'),
        key: 'F',
        cn: '霓虹夜场',
        en: 'Neon Night',
        bg: '#0b0d17',
        border: false,
        tag: '暗色 · 新',
        desc: '暗底荧光粉青渐变、跑马灯横幅、霓虹画框卡阵——为板绘而生的夜场。',
      },
      {
        href: withBase('/g'),
        key: 'G',
        cn: '卡牌收藏墙',
        en: 'Card Vault',
        bg: '#f5f2ff',
        border: true,
        tag: '亮色 · 新',
        desc: '每件作品是一张收藏卡：渐变卡边、悬停 3D 倾斜 + 流光扫过，收藏册气质。',
      },
      {
        href: withBase('/e'),
        key: 'E',
        cn: '拼贴手帐',
        en: 'Scrapbook',
        bg: '#f6f0e1',
        border: true,
        tag: '亮色',
        desc: '胶带宝丽来墙，微微歪斜、悬停摆正，手作感轻松可爱。',
      },
    ],
  },
  {
    name: '衬托系 · 让作品站上中性舞台',
    hint: '画廊白、长廊、暗场满版——职业作品集常见的「安静舞台」打法，高饱和作品反而突出',
    items: [
      {
        href: withBase('/'),
        key: 'A',
        cn: '美术馆白画册',
        en: 'Museum Catalogue',
        bg: '#fafaf8',
        border: true,
        tag: '现状',
        desc: '白底衬线字、白卡纸挂画框、瀑布流 + 系列筛选——高饱和插画的中性舞台。',
      },
      {
        href: withBase('/b'),
        key: 'B',
        cn: '全屏沉浸画廊',
        en: 'Immersive Wall',
        bg: '#0f0f0e',
        border: false,
        tag: '暗色',
        desc: '暗底满版图墙，无画框无说明，作品铺满屏幕即界面。',
      },
      {
        href: withBase('/c'),
        key: 'C',
        cn: '电影翻阅画册',
        en: 'Cinema Lookbook',
        bg: '#161412',
        border: false,
        tag: '暗首屏',
        desc: '整张画铺满首屏 + 大字压图开卷，往下一页一画交错翻阅。',
      },
      {
        href: withBase('/d'),
        key: 'D',
        cn: '横向长廊',
        en: 'Corridor',
        bg: '#efece6',
        border: true,
        tag: '亮色',
        desc: '页面只横向滚动：滚轮/拖动向右看展，顶部进度线。',
      },
    ],
  },
];
---

<BaseLayout title="界面方案挑选 · HEHXumike" description="八套完全不同的界面结构方案预览。">
  <header class="page-head" data-reveal>
    <p class="eyebrow">Layout Concepts · 界面方案</p>
    <h1>挑一个界面</h1>
    <p class="lede">
      八套方案是<b>完全不同的界面结构</b>。上半部分和你的作品同频，下半部分是「安静衬托」的经典打法
      —— 每个都点进去走一遍再选。
    </p>
  </header>

  {
    groups.map((g) => (
      <section class="group">
        <header class="ghead" data-reveal>
          <h2>{g.name}</h2>
          <p>{g.hint}</p>
        </header>
        <ul class="plans">
          {g.items.map((p) => (
            <li data-reveal>
              <a href={p.href}>
                <span class="key">{p.key}</span>
                <span
                  class="swatch"
                  style={`background:${p.bg};${p.border ? 'border:1px solid #cfcac0;' : ''}`}
                />
                <span class="names">
                  <span class="row1">
                    <span class="ch-cn">{p.cn}</span>
                    <span class="eyebrow">{p.en}</span>
                  </span>
                  <span class="desc">{p.desc}</span>
                </span>
                <span class="tag">{p.tag}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .group {
    margin-bottom: 3rem;
  }
  .ghead {
    padding: 1.6rem 0.25rem 0.4rem;
  }
  .ghead h2 {
    font-size: 1.15rem;
    letter-spacing: 0.1em;
  }
  .ghead p {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .plans {
    list-style: none;
    padding: 0;
  }
  .plans a {
    display: grid;
    grid-template-columns: auto auto 1fr auto auto;
    align-items: center;
    gap: 1.4rem;
    padding: 1.5rem 0.25rem;
    border-top: 1px solid var(--line);
    transition:
      padding-left 0.35s var(--ease),
      background 0.35s var(--ease);
  }
  .plans li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .plans a:hover {
    padding-left: 1rem;
    background: #fff;
  }
  .key {
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 2rem;
    color: #cdc9bd;
    width: 2.2rem;
    text-align: center;
  }
  .swatch {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgb(26 26 26 / 0.12);
  }
  .names {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .row1 {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .ch-cn {
    font-size: 1.12rem;
    letter-spacing: 0.08em;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .tag {
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    padding: 0.18rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .arrow {
    color: var(--muted);
    transition:
      transform 0.35s var(--ease),
      color 0.3s;
  }
  .plans a:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--ink);
  }
  @media (max-width: 768px) {
    .plans a {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'key names tag'
        'sw desc desc';
      row-gap: 0.6rem;
    }
    .key {
      grid-area: key;
      width: auto;
      font-size: 1.5rem;
    }
    .names {
      grid-area: names;
    }
    .swatch {
      grid-area: sw;
      width: 2rem;
      height: 2rem;
    }
    .desc {
      grid-area: desc;
    }
    .tag {
      grid-area: tag;
    }
    .arrow {
      display: none;
    }
  }
</style>
