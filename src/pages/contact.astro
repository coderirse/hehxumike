---
import { Icon } from "astro-icon/components";
import { CONTACT_LINKS } from "@/config/contactConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "联系";
const description = "约稿、交流，或只是打个招呼，都在这里。";
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<div class="card-base p-6 md:p-9">
			<p class="mb-6 text-sm text-neutral-500 dark:text-neutral-400">{description}</p>
			<ul class="flex flex-col divide-y divide-(--line-divider)">
				{
					CONTACT_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								{...(link.href.startsWith("http")
									? { target: "_blank", rel: "noopener" }
									: {})}
								class="group flex items-center gap-4 py-5 transition-all duration-300 hover:pl-2"
							>
								<span class="text-(--primary) text-2xl">
									<Icon name={link.icon} />
								</span>
								<span class="flex-1 min-w-0">
									<span class="block text-lg font-medium text-neutral-900 dark:text-neutral-100">
										{link.cn}
									</span>
									<span class="block text-xs tracking-wider text-neutral-400 dark:text-neutral-500">
										{link.en}
									</span>
								</span>
								<span class="hidden sm:block text-sm text-neutral-500 dark:text-neutral-400">
									{link.handle}
								</span>
								<Icon
									name="material-symbols:arrow-outward"
									class="text-lg text-neutral-400 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</MainGridLayout>

<style is:global>
	/* 联系页已有完整渠道列表，移动端不再重复资料/公告/动态卡 */
	#mobile-bottom-sidebar {
		display: none !important;
	}
</style>