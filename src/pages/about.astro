---
// 关于：艺术家自述 + 履历 + 接稿说明（文案见 src/content/about.md，待用户补充）
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait.jpg';

const entry = (await getCollection('about'))[0];
if (!entry) throw new Error('缺少 src/content/about.md');
const { Content } = await render(entry);
---

<BaseLayout title="关于 · HEHXumike" description="关于画家 HEHXumike——创作自述与履历。">
  <header class="page-head" data-reveal>
    <p class="eyebrow">About · 关于</p>
    <h1>画者自述</h1>
  </header>

  <section class="about-grid">
    <figure class="portrait" data-reveal>
      <span class="mat">
        <Image
          src={portrait}
          alt="画家肖像（占位图）"
          widths={[480, 720]}
          sizes="(max-width: 768px) 80vw, 320px"
          loading="lazy"
        />
      </span>
      <figcaption class="eyebrow">Portrait · 肖像</figcaption>
    </figure>
    <article class="about-body" data-reveal>
      <Content />
    </article>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    align-items: start;
  }
  .portrait {
    position: sticky;
    top: 2rem;
  }
  .portrait figcaption {
    margin-top: 0.8rem;
  }
  .about-body :global(h2) {
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    margin: 2.25rem 0 0.9rem;
  }
  .about-body :global(h2:first-child) {
    margin-top: 0;
  }
  .about-body :global(p) {
    margin-bottom: 0.9rem;
  }
  .about-body :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-style: normal;
  }
  .about-body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
  }
  .about-body :global(li) {
    padding: 0.55rem 0;
    border-top: 1px dashed var(--line);
    font-size: 0.9375rem;
  }
  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      max-width: 320px;
    }
  }
</style>
