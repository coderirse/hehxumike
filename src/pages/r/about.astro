---
// 方案 R · 关于：画带 + 肖像与自述（文案见 src/content/about.md）
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import RLayout from '../../layouts/RLayout.astro';
import portrait from '../../assets/portrait.jpg';

const entry = (await getCollection('about'))[0];
if (!entry) throw new Error('缺少 src/content/about.md');
const { Content } = await render(entry);
---

<RLayout
  title="关于 · HEHXumike"
  description="关于画家 HEHXumike——创作自述与履历。"
  active="about"
  bandTitle="关于"
  bandEn="About · The Artist"
>
  <section class="r-about">
    <figure class="r-portrait">
      <Image
        src={portrait}
        alt="画家肖像（占位图）"
        widths={[480, 720]}
        sizes="(max-width: 900px) 80vw, 320px"
        loading="lazy"
      />
      <figcaption class="r-en">Portrait · 肖像</figcaption>
    </figure>
    <article class="r-prose">
      <Content />
    </article>
  </section>
</RLayout>