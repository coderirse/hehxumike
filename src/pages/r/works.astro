---
// 方案 R · 作品页：画带 + 系列筛选 + 方格墙 + 灯箱
import { getCollection } from 'astro:content';
import RLayout from '../../layouts/RLayout.astro';
import RCell from '../../components/RCell.astro';
import Lightbox from '../../components/Lightbox.astro';
import { SERIES } from '../../content.config';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<RLayout
  title="作品 · HEHXumike"
  description="HEHXumike 的全部画作——按系列浏览：角色插画、节日贺图、封面与自设、速写与练习。"
  active="works"
  bandTitle="作品"
  bandEn="Works · Gallery"
>
  <p class="r-lede">共 {works.length} 件 · 按完成时间倒序</p>

  <div class="r-filter" role="group" aria-label="按系列筛选">
    <button class="on" data-filter="*">全部</button>
    {SERIES.map((s) => <button data-filter={s}>{s}</button>)}
  </div>

  <div class="r-grid pswp-gallery">
    {works.map((w) => <RCell work={w} />)}
  </div>

  <Lightbox />
</RLayout>

<script>
  // 系列筛选：隐藏非该系列格子，方格墙自动回流
  document.addEventListener('astro:page-load', () => {
    const gallery = document.querySelector('.r-grid');
    if (!gallery) return;
    const btns = document.querySelectorAll<HTMLButtonElement>('.r-filter button');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('on', x === b));
        const f = b.dataset.filter ?? '*';
        gallery.querySelectorAll<HTMLElement>('.r-cell').forEach((w) => {
          w.hidden = f !== '*' && w.dataset.series !== f;
        });
      })
    );
  });
</script>