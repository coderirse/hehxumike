---
// 方案 R · 联系：画带 + 渠道列表（真实链接集中在 src/data/contact.ts）
import RLayout from '../../layouts/RLayout.astro';
import { CONTACT_LINKS } from '../../data/contact';
---

<RLayout
  title="联系 · HEHXumike"
  description="联系画家 HEHXumike——社交平台与邮箱。"
  active="contact"
  bandTitle="联系"
  bandEn="Contact · Say Hello"
>
  <section class="r-contact">
    <p class="lede">约稿、交流，或只是打个招呼，都在这里。</p>
    <ul class="r-channels">
      {
        CONTACT_LINKS.map((l) => (
          <li>
            <a
              href={l.href}
              {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="r-ch-cn">{l.cn}</span>
              <span class="r-en">{l.en}</span>
              <span class="r-ch-handle">{l.handle}</span>
              <span class="r-ch-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</RLayout>