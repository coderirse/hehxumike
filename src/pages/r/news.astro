---
// 方案 R · 动态：画带 + 展讯 / 上新时间线
import { getCollection, render } from 'astro:content';
import RLayout from '../../layouts/RLayout.astro';

const items = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const rendered = await Promise.all(
  items.map(async (n) => ({ ...n, Content: (await render(n)).Content }))
);
const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月`;
---

<RLayout
  title="动态 · HEHXumike"
  description="HEHXumike 的展讯与上新动态。"
  active="news"
  bandTitle="动态"
  bandEn="News & Updates"
>
  <ol class="r-news">
    {
      rendered.map(({ data, Content }) => (
        <li>
          <time>{fmt(data.date)}</time>
          <div>
            <span class="tag r-en">{data.tag}</span>
            <h3>{data.title}</h3>
            <Content />
          </div>
        </li>
      ))
    }
  </ol>
</RLayout>