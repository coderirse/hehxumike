---
// 单件作品：挂画式卡片（点击打开灯箱）
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  work: CollectionEntry<'works'>;
  index: number;
}

const { work, index } = Astro.props;
const d = work.data;
const n = String(index + 1).padStart(2, '0');
const meta = [d.year, d.medium, d.size].filter(Boolean).join(' · ');
---

<figure class="work" data-series={d.series} data-reveal>
  <a
    class="mat"
    href={d.image.src}
    data-pswp
    data-width={d.image.width}
    data-height={d.image.height}
    data-title={d.title}
    data-title-en={d.titleEn ?? ''}
    data-meta={meta}
  >
    <Image
      src={d.image}
      alt={d.title}
      widths={[480, 840, 1200]}
      sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 30vw"
      loading="lazy"
    />
  </a>
  <figcaption>
    <span class="work-no eyebrow">{n}</span>
    <span class="work-title">《{d.title}》</span>
    {d.titleEn && <span class="work-en eyebrow">{d.titleEn}</span>}
    <span class="work-meta">{meta}</span>
  </figcaption>
</figure>
