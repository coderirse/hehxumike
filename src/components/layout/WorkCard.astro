---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	loading?: "lazy" | "eager";
}

const { entry, loading = "lazy" } = Astro.props;
const href = getPostUrlBySlug(entry.id);
const series = entry.data.series || entry.data.category || "作品";
const year = entry.data.published.getFullYear();
---

<a
	href={href}
	class="work-card group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary) focus-visible:ring-offset-4 focus-visible:ring-offset-(--page-bg)"
	aria-label={`查看作品《${entry.data.title}》`}
>
	<div class="work-card-media relative overflow-hidden rounded-xl ring-1 ring-black/5 dark:ring-white/10">
		<CoverImage
			src={entry.data.image}
			basePath={getFileDirFromPath(entry.filePath || "")}
			alt={`《${entry.data.title}》作品图`}
			class="work-card-cover w-full"
			naturalHeight={true}
			preview={true}
			loading={loading}
		/>
		<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050b18]/55 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
		<div class="pointer-events-none absolute inset-x-3 bottom-3 flex items-center justify-between opacity-0 transition-opacity duration-300 group-hover:opacity-100">
			<span class="rounded-full bg-white/92 px-3 py-1 text-xs font-medium text-[#0b1526] shadow-sm">
				查看作品
			</span>
			<span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/92 text-[#0b1526] shadow-sm">
				<Icon name="material-symbols:arrow-outward-rounded" class="text-lg" />
			</span>
		</div>
	</div>

	<div class="work-card-caption flex items-start justify-between gap-3 px-1 pt-3">
		<div class="min-w-0">
			<h3 class="truncate text-[1.05rem] font-bold leading-snug text-black/85 transition-colors group-hover:text-(--primary) dark:text-white/90">
				{entry.data.title}
			</h3>
			<p class="mt-1 text-xs tracking-wide text-black/55 dark:text-white/60">
				{series} · {year}
			</p>
		</div>
		<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-(--primary)/10 text-(--primary) opacity-0 transition-opacity group-hover:opacity-100">
			<Icon name="material-symbols:chevron-right-rounded" class="text-lg" />
		</span>
	</div>
</a>

<style>
	.work-card-media {
		background: var(--card-bg);
		box-shadow: 0 10px 30px -18px rgba(4, 10, 24, 0.45);
		transition:
			box-shadow 0.3s ease,
			transform 0.3s ease;
	}

	.work-card:hover .work-card-media {
		box-shadow: 0 18px 42px -20px rgba(4, 10, 24, 0.55);
		transform: translateY(-2px);
	}

	.work-card-cover {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-card-media {
			transition: none;
		}
		.work-card:hover .work-card-media {
			transform: none;
		}
	}
</style>